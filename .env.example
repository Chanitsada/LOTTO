# Local settings for Express, MySQL, signed sessions and privileged account seeding.
# Settings load from the LOTTO root; health/static startup requires no credentials.
# PORT configures Express; DB_* configures the shared account/lottery MySQL pool.
# RAM sessions use SESSION_SECRET; backend restart clears login, not saved accounts.
# npm run seed:accounts creates missing Admin/Developer website accounts.
NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lotto
DB_USER=REPLACE_WITH_LOCAL_DB_USER
# Quote passwords containing # so dotenv keeps the complete value.
DB_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
# Generate a secret: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Use a different generated value on each teammate's computer; never commit it.
SESSION_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET

# Separate privileged account settings; public signup creates Customers only.
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=REPLACE_WITH_LOCAL_ADMIN_PASSWORD
SEED_DEVELOPER_EMAIL=developer@example.invalid
SEED_DEVELOPER_PASSWORD=REPLACE_WITH_LOCAL_DEVELOPER_PASSWORD
